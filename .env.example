PORT=4000
# CORS allow-list: the frontend origin (required in production)
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated extra origins, e.g. https://staging.example.com
# EXTRA_CORS_ORIGINS=
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Invoicing (Microsoft 365 send + PDF)
# Licensed M365 mailbox used to send quotation/invoice emails (also appears in Sent Items)
MS_GRAPH_SEND_FROM_EMAIL=info@clarustologistics.com
# Legacy alias — used if MS_GRAPH_SEND_FROM_EMAIL is not set
INVOICE_FROM_EMAIL=info@clarustologistics.com
COMPANY_NAME=Clarusto Logistics LTD
COMPANY_PHONE=+966 53 570 6708
COMPANY_ADDRESS=C/o NOORA WAQAIYAN AL DOSSARY EST|PO Box – 8147, Riyadh – 14513|Kingdom of Saudi Arabia
COMPANY_VAT_NUMBER=#300828318400003
INVOICE_STORAGE_BUCKET=documents
# Logo on PDF (defaults to backend/assets/clarusto-logo.png — use white-bg image with dark text)
# INVOICE_LOGO_PATH=./assets/clarusto-logo.png
# INVOICE_LOGO_HEADER_STYLE=light
# Use INVOICE_LOGO_HEADER_STYLE=dark only if your logo file has a black background

# Microsoft 365 / Outlook — company email sync and outbound quotation/invoice send
MS_GRAPH_TENANT_ID=your_azure_tenant_id
MS_GRAPH_CLIENT_ID=your_azure_app_client_id
# IMPORTANT: Use the secret "Value" from Azure Certificates & secrets (shown ONCE when created).
# Do NOT use the "Secret ID" (UUID) — that causes AADSTS7000215 Invalid client secret.
MS_GRAPH_CLIENT_SECRET=your_azure_app_client_secret_value
MS_GRAPH_DOMAIN=clarusto.co.uk
# Comma-separated domains to sync (staff often use tenant.onmicrosoft.com, not custom domain)
MS_GRAPH_DOMAINS=clarusto.co.uk,yourtenant.onmicrosoft.com
MS_GRAPH_SYNC_ALLOWLIST=Jose F,Manju,Om Wankar,Padma,R John,Santosh Nair,Shyam,Vikram,Palak Kushwaha,Ansu,ansu@clarusto.co.uk,info@clarusto.co.uk
MS_GRAPH_SYNC_ALL_TENANT_USERS=false
MS_GRAPH_SYNC_DAYS=30
EMAIL_SYNC_CRON=*/10 * * * *
# EMAIL_SYNC_CRON_SECRET=long-random-string

